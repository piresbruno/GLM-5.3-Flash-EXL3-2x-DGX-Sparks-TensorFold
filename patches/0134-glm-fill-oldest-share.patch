                          f" up to the {prefill_rows}-row prompt chunk, not {value!r}")
+    return rows
+
+
+def fill_oldest_rows(fill: int, unit: int, value: str | None = None) -> int:
+    """TF_GLM_FILL_OLDEST_ROWS: rows of every multi-prompt chunk the oldest waiting prompt takes before the others are
+    packed shortest first (0, the default: none, every prompt shortest first). A multiple of the fill unit (64 and
+    the prompt grid), at most TF_GLM_FILL_ROWS."""
+
+    value = os.environ.get("TF_GLM_FILL_OLDEST_ROWS", "") if value is None else value
+    value = value.strip()
+    rows = 0 if value == "" else int(value) if value.isdecimal() else -1
+    if rows and (rows < unit or rows % unit or rows > fill):
+        raise ValueError(f"TF_GLM_FILL_OLDEST_ROWS: 0, or a multiple of {unit} up to the {fill}-row fill chunk "
+                         f"(TF_GLM_FILL_ROWS), not {value!r}")
     return rows
 
 
